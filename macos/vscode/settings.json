{
  "editor.fontSize": 13,
  "editor.fontFamily": "'FiraCode Nerd Font', Monaco, 'Courier New', monospace",
  "workbench.colorTheme": "Catppuccin Mocha",
  "catppuccin.italicKeywords": false,
  "catppuccin.accentColor": "lavender",
  "chat.commandCenter.enabled": false,
  "workbench.activityBar.location": "top",
  "workbench.navigationControl.enabled": false,
  "workbench.editor.showTabs": "single",
  "editor.stickyScroll.enabled": false,
  "breadcrumbs.enabled": false,
  "editor.cursorSurroundingLines": 8,
  "editor.lineNumbers": "relative",
  "vim.insertModeKeyBindings": [
    {
      "before": ["j", "k"],
      "after": ["<Esc>"],
    },
  ],
  "editor.glyphMargin": false,
  "workbench.editor.editorActionsLocation": "titleBar",
  "terminal.integrated.fontSize": 13,
  "editor.lightbulb.enabled": "off",
  "editor.renderLineHighlight": "none",
  "workbench.startupEditor": "none",
  "[hcl]": {
    "editor.tabSize": 2,
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
    },
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
  },
  "[markdown]": {
    "editor.tabSize": 2,
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
  },
  "[restructuredtext]": {
    "editor.tabSize": 3,
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
    },
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
    },
  },
  "autoDocstring.docstringFormat": "google-notypes",
  "dev.containers.defaultExtensions": [
    "Anthropic.claude-code",
    "charliermarsh.ruff",
    "dbaeumer.vscode-eslint",
    "esbenp.prettier-vscode",
    "ExecutableBookProject.myst-highlight",
    "hashicorp.hcl",
    "meta.pyrefly",
    "ms-python.python",
    "njpwerner.autodocstring",
    "tamasfe.even-better-toml",
  ],
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
  },
  "editor.detectIndentation": false,
  "editor.formatOnSave": true,
  "editor.rulers": [120],
  "editor.tabSize": 4,
  "eslint.format.enable": true,
  "evenBetterToml.schema.enabled": false,
  "files.eol": "\n",
  "files.exclude": {
    "**/__pycache__": true,
    "**/.*_cache": true,
    "**/.coverage.*": true,
    "**/.coverage": true,
    "**/.git": true,
    "**/.venv": true,
    "**/*.benchmarks": true,
    "**/*.egg-info": true,
    "**/*.hypothesis": true,
    "**/*.pyc": true,
    "**/*.pyo": true,
    "**/cdk.out": true,
    "**/dist": true,
    "**/docs/_build": true,
    "**/node_modules": true,
    "**/target": true,
  },
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "files.watcherExclude": {
    "**/.*_cache": true,
    "**/.venv": true,
    "**/docs/_build": true,
    "**/node_modules": true,
  },
  "prettier.prettierPath": "./node_modules/prettier",
  "python.analysis.typeCheckingMode": "off",
  "python.languageServer": "None",
  "remote.autoForwardPortsFallback": 0,
  "remote.autoForwardPortsSource": "process",
  "remote.SSH.defaultExtensions": [
    "Anthropic.claude-code",
    "charliermarsh.ruff",
    "dbaeumer.vscode-eslint",
    "esbenp.prettier-vscode",
    "ExecutableBookProject.myst-highlight",
    "hashicorp.hcl",
    "meta.pyrefly",
    "ms-python.python",
    "njpwerner.autodocstring",
    "tamasfe.even-better-toml",
  ],
  "telemetry.telemetryLevel": "off",
  "terminal.integrated.initialHint": false,
  "remote.containers.dotfiles.repository": "git@github.com:alex-teder-wf/dotfiles",
  "workbench.editor.enablePreview": false,
  "claudeCode.preferredLocation": "sidebar",
  "workbench.browser.showInTitleBar": false,
  "window.commandCenter": false,
  "workbench.colorCustomizations": {
    "terminal.background": "#00000000",
    "editorPane.background": "#1e1e1e00",
    "editorGroupHeader.tabsBackground": "#1e1e1e00",
    "editorGroupHeader.noTabsBackground": "#1e1e1e00",
    "breadcrumb.background": "#1e1e1e00",
    "editorGutter.background": "#1e1e1e00",
    "panel.background": "#1e1e1e00",
    "panelStickyScroll.background": "#1e1e1e00",
    "tab.activeBackground": "#1e1e1e00",
    "tab.unfocusedActiveBackground": "#1e1e1e00",
    "sideBar.background": "#1e1e1e4d",
    "sideBarTitle.background": "#1e1e1e4d",
    "sideBarStickyScroll.background": "#1e1e1e4d",
    "activityBar.background": "#1e1e1e4d",
    "editor.background": "#1e1e1e4d",
    "editorStickyScroll.background": "#1e1e1e4d",
    "editorStickyScrollGutter.background": "#1e1e1e4d",
    "tab.inactiveBackground": "#1e1e1e4d",
    "tab.unfocusedInactiveBackground": "#1e1e1e4d",
    "inlineChat.background": "#1e1e1ee6",
    "editorWidget.background": "#1e1e1ee6",
    "editorHoverWidget.background": "#1e1e1ee6",
    "editorSuggestWidget.background": "#1e1e1ee6",
    "notifications.background": "#1e1e1ee6",
    "notificationCenterHeader.background": "#1e1e1ee6",
    "menu.background": "#1e1e1ee6",
    "quickInput.background": "#1e1e1ee6",
  },
  "terminal.integrated.gpuAcceleration": "off",
  "window.systemColorTheme": "dark",
  "window.autoDetectColorScheme": false,
  "window.titleBarStyle": "custom",
  "window.zoomLevel": 0.625,
  "editor.minimap.enabled": false,
  "workbench.layoutControl.enabled": false,
  "terminal.integrated.stickyScroll.enabled": false,
  "terminal.integrated.localEchoLatencyThreshold": 0,
  "update.showReleaseNotes": false,
  "terminal.integrated.localEchoEnabled": "on",
  "terminal.integrated.localEchoExcludePrograms": [],
  "security.workspace.trust.untrustedFiles": "open",
  "terminal.integrated.shellIntegration.decorationsEnabled": "never",
  "terminal.integrated.shellIntegration.history": 1000,
}
