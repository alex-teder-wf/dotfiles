#!/usr/bin/env node
const path = require("node:path");
const { exec } = require("node:child_process");
const { promisify } = require("node:util");

const _exec = promisify(exec);
const run = (command) =>
  _exec(command).then(({ stdout }) => console.log(stdout));

const NEOVIM_CONFIG_URL = "https://github.com/alex-teder/nvim-config-v2.git";
const neovimConfigDestination = path.join(process.env.HOME, ".config", "nvim");

(async () => {
  try {
    await run("apt update");
    await run("apt install ripgrep neovim=0.9.5-6ubuntu2 -y");
    await run(
      `git clone --branch wf-dotfiles ${NEOVIM_CONFIG_URL} ${neovimConfigDestination}`,
    );
  } catch (err) {
    console.error(err);
    process.exit(0);
  }
})();
